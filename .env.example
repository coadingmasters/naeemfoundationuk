APP_NAME="Naeem Foundation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Address lookup (postcode -> address) ---
# 'postcodes' = postcodes.io, free and keyless, but returns town/region ONLY —
#               the donor still types their house number and street.
# 'getaddress' = getaddress.io, needs a paid key, returns every address at a
#                postcode so Billing Address auto-fills from the dropdown.
# See config/address.php. Run `php artisan config:clear` after changing these.
ADDRESS_UK_PROVIDER=postcodes
GETADDRESS_KEY=

# --- PayPal ---
PAYPAL_MODE=sandbox
PAYPAL_BRAND_NAME="Naeem Foundation"
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=

# --- CRM (Lumrick) donation webhook -----------------------------------------
# Keep OFF until keys are set and a staging test donation has worked.
# Secrets belong in the server's .env only — never commit them.
CRM_ENABLED=false
# Recurring gifts need the CRM's GoCardless connection. Leave false until it works;
# recurring baskets then keep using the site's PayPal flow.
CRM_RECURRING=false
CRM_WEBHOOK_URL=https://crmbackend.rentpe.co.uk/api/webhooks/donations/cart
# One key + secret per CRM branch (= per currency). A currency without keys
# keeps using PayPal, so US/Canada can be switched over later.
CRM_GBP_API_KEY=
CRM_GBP_SIGNING_SECRET=
CRM_USD_API_KEY=
CRM_USD_SIGNING_SECRET=
CRM_CAD_API_KEY=
CRM_CAD_SIGNING_SECRET=
# Secret for the private test link /donate/crm-preview/<token> (leave empty to disable).
CRM_PREVIEW_TOKEN=
